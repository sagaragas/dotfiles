# ─── History ────────────────────────────────────────────────────────────
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:ignorespace
shopt -s histappend

# ─── Path ───────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ─── Cargo ──────────────────────────────────────────────────────────────
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
