# ─── grep colors (Modus Operandi Tinted) ────────────────────────────────
export GREP_COLOR="38;2;166;0;0"
export GREP_COLORS="mt=38;2;166;0;0:fn=38;2;89;89;89:ln=38;2;89;89;89:se=38;2;166;166;166"
alias grep="grep --color=auto"

# ─── man pages colors (Modus Operandi Tinted) ───────────────────────────
export LESS_TERMCAP_mb=$'\033[38;2;151;37;0m'
export LESS_TERMCAP_md=$'\033[38;2;166;0;0m'
export LESS_TERMCAP_me=$'\033[0m'
export LESS_TERMCAP_so=$'\033[38;2;251;247;240;48;2;166;0;0m'
export LESS_TERMCAP_se=$'\033[0m'
export LESS_TERMCAP_us=$'\033[38;2;0;104;0m'
export LESS_TERMCAP_ue=$'\033[0m'
export LESS="-R"

# ─── diff colors ───────────────────────────────────────────────────────
alias diff="diff --color=auto"

# ─── Aliases ────────────────────────────────────────────────────────────
# Personal aliases live in ~/.aliases.local (private, not tracked in this repo).
[ -f "$HOME/.aliases.local" ] && source "$HOME/.aliases.local"

# ─── History ────────────────────────────────────────────────────────────
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:ignorespace
shopt -s histappend

# ─── Path ───────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ─── Cargo ──────────────────────────────────────────────────────────────
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
