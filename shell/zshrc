# ─── Prompt (Flexoki Light) ─────────────────────────────────────
PS1=$'%{\033[38;2;175;48;41m%}%n%{\033[0m%}:%{\033[38;2;16;15;15m%}%~%{\033[0m%}%{\033[38;2;111;110;105m%}\$%{\033[0m%} '

# ─── ls colors (Flexoki Light) ──────────────────────────────────
# macOS LSCOLORS: 11 pairs (fg+bg) for:
#   directory, symlink, socket, pipe, exec, block-special,
#   char-special, setuid-exec, setgid-exec, sticky-dir, no-sticky-dir
# Flexoki: dirs=red, symlinks=cyan, exec=green, sockets=magenta
export CLICOLOR=1
export LSCOLORS="Dxgxfxdxcxegedabagacad"

# GNU LS_COLORS (for coreutils ls, tree, eza, fd, etc.)
export LS_COLORS="di=1;38;2;175;48;41:ln=38;2;36;131;123:so=38;2;160;47;111:pi=38;2;173;131;1:ex=38;2;102;128;11:bd=38;2;32;94;166:cd=38;2;32;94;166:su=38;2;209;77;65:sg=38;2;209;77;65:tw=38;2;175;48;41;48;2;206;205;195:ow=38;2;175;48;41:*.md=38;2;111;110;105:*.json=38;2;173;131;1:*.toml=38;2;173;131;1:*.yaml=38;2;173;131;1:*.yml=38;2;173;131;1:*.ts=38;2;32;94;166:*.tsx=38;2;32;94;166:*.js=38;2;173;131;1:*.py=38;2;102;128;11:*.rs=38;2;175;48;41:*.go=38;2;36;131;123:*.sh=38;2;102;128;11:*.css=38;2;160;47;111:*.html=38;2;175;48;41:*.svg=38;2;175;48;41:*.png=38;2;160;47;111:*.jpg=38;2;160;47;111:*.gif=38;2;160;47;111:*.zip=38;2;175;48;41:*.tar=38;2;175;48;41:*.gz=38;2;175;48;41:*.log=38;2;111;110;105:*.bak=38;2;111;110;105:*.tmp=38;2;111;110;105"

# ─── grep colors (Flexoki Light) ────────────────────────────────
export GREP_OPTIONS="--color=auto"
export GREP_COLOR="38;2;175;48;41"
export GREP_COLORS="mt=38;2;175;48;41:fn=38;2;111;110;105:ln=38;2;111;110;105:se=38;2;183;181;172"
alias grep="grep --color=auto"

# ─── man pages colors (Flexoki Light) ───────────────────────────
export LESS_TERMCAP_mb=$'\033[38;2;209;77;65m'
export LESS_TERMCAP_md=$'\033[38;2;175;48;41m'
export LESS_TERMCAP_me=$'\033[0m'
export LESS_TERMCAP_so=$'\033[38;2;255;252;240;48;2;166;0;0m'
export LESS_TERMCAP_se=$'\033[0m'
export LESS_TERMCAP_us=$'\033[38;2;102;128;11m'
export LESS_TERMCAP_ue=$'\033[0m'

# ─── less pager (Flexoki Light) ─────────────────────────────────
export LESS="-R"

# ─── diff colors ───────────────────────────────────────────────────────
alias diff="diff --color=auto"

# ─── zsh completion colors ─────────────────────────────────────────────
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format $'\033[38;2;175;48;41m-- %d --\033[0m'
zstyle ':completion:*:messages' format $'\033[38;2;111;110;105m-- %d --\033[0m'
zstyle ':completion:*:warnings' format $'\033[38;2;209;77;65m-- no matches --\033[0m'

# ─── Aliases ────────────────────────────────────────────────────────────
# Personal aliases live in ~/.aliases.local (private, not tracked in this repo).
[ -f "$HOME/.aliases.local" ] && source "$HOME/.aliases.local"

export PATH="$HOME/.local/bin:$PATH"


# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

autoload -Uz compinit && compinit
