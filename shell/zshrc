PS1=$'%{\033[38;2;166;227;161m%}%n%{\033[0m%}:%{\033[38;2;249;226;175m%}%~%{\033[0m%}%{\033[38;2;205;214;244m%}\$%{\033[0m%} '

# ─── Aliases ────────────────────────────────────────────────────────────
alias cf="***REMOVED*** tunnel run"
alias prox1="ssh root@***REMOVED***"
alias prox2="ssh root@***REMOVED***"
alias prox3="ssh root@***REMOVED***"
alias prox4="ssh root@***REMOVED***"

alias ll="ls -lAh"
alias ..="cd .."
