# ─── Prompt (Moonfly) ───────────────────────────────────────────
PS1=$'%{\033[38;2;174;129;255m%}%n%{\033[0m%}:%{\033[38;2;189;189;189m%}%~%{\033[0m%}%{\033[38;2;148;148;148m%}\$%{\033[0m%} '

# ─── ls colors (Moonfly) ────────────────────────────────────────
# macOS LSCOLORS: 11 pairs (fg+bg) for:
#   directory, symlink, socket, pipe, exec, block-special,
#   char-special, setuid-exec, setgid-exec, sticky-dir, no-sticky-dir
# Limited to the 8 ANSI slots, so dirs use bold magenta, which resolves to
# the Moonfly violet accent. Symlinks=cyan, sockets=magenta, exec=green.
export CLICOLOR=1
export LSCOLORS="Fxgxfxdxcxegedabagacad"

# GNU LS_COLORS (for coreutils ls, tree, eza, fd, etc.)
export LS_COLORS="di=1;38;2;174;129;255:ln=38;2;121;218;200:so=38;2;207;135;232:pi=38;2;227;199;138:ex=38;2;140;200;95:bd=38;2;128;160;255:cd=38;2;128;160;255:su=38;2;255;81;137:sg=38;2;255;81;137:tw=38;2;174;129;255;48;2;50;52;55:ow=38;2;174;129;255:*.md=38;2;148;148;148:*.json=38;2;227;199;138:*.toml=38;2;227;199;138:*.yaml=38;2;227;199;138:*.yml=38;2;227;199;138:*.ts=38;2;128;160;255:*.tsx=38;2;128;160;255:*.js=38;2;227;199;138:*.py=38;2;140;200;95:*.rs=38;2;255;84;84:*.go=38;2;121;218;200:*.sh=38;2;140;200;95:*.css=38;2;207;135;232:*.html=38;2;255;84;84:*.svg=38;2;255;84;84:*.png=38;2;207;135;232:*.jpg=38;2;207;135;232:*.gif=38;2;207;135;232:*.zip=38;2;255;84;84:*.tar=38;2;255;84;84:*.gz=38;2;255;84;84:*.log=38;2;148;148;148:*.bak=38;2;148;148;148:*.tmp=38;2;148;148;148"

# ─── grep colors (Moonfly) ──────────────────────────────────────
export GREP_OPTIONS="--color=auto"
export GREP_COLOR="38;2;174;129;255"
export GREP_COLORS="mt=38;2;174;129;255:fn=38;2;148;148;148:ln=38;2;148;148;148:se=38;2;50;52;55"
alias grep="grep --color=auto"

# ─── man pages colors (Moonfly) ─────────────────────────────────
export LESS_TERMCAP_mb=$'\033[38;2;255;81;137m'
export LESS_TERMCAP_md=$'\033[38;2;174;129;255m'
export LESS_TERMCAP_me=$'\033[0m'
export LESS_TERMCAP_so=$'\033[38;2;8;8;8;48;2;174;129;255m'
export LESS_TERMCAP_se=$'\033[0m'
export LESS_TERMCAP_us=$'\033[38;2;140;200;95m'
export LESS_TERMCAP_ue=$'\033[0m'

# ─── less pager (Moonfly) ───────────────────────────────────────
export LESS="-R"

# ─── diff colors ───────────────────────────────────────────────────────
alias diff="diff --color=auto"

# ─── zsh completion colors ─────────────────────────────────────────────
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format $'\033[38;2;174;129;255m-- %d --\033[0m'
zstyle ':completion:*:messages' format $'\033[38;2;148;148;148m-- %d --\033[0m'
zstyle ':completion:*:warnings' format $'\033[38;2;255;81;137m-- no matches --\033[0m'

# ─── Aliases ────────────────────────────────────────────────────────────
# Personal aliases live in ~/.aliases.local (private, not tracked in this repo).
[ -f "$HOME/.aliases.local" ] && source "$HOME/.aliases.local"

export PATH="$HOME/.local/bin:$PATH"


# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

autoload -Uz compinit && compinit
