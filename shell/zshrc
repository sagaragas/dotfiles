# ─── man pages colors (Factory) ────────────────────────────────────────
export LESS_TERMCAP_mb=$'\033[38;2;248;113;113m'
export LESS_TERMCAP_md=$'\033[38;2;239;111;46m'
export LESS_TERMCAP_me=$'\033[0m'
export LESS_TERMCAP_so=$'\033[38;2;2;2;2;48;2;239;111;46m'
export LESS_TERMCAP_se=$'\033[0m'
export LESS_TERMCAP_us=$'\033[38;2;52;211;153m'
