# ─── Prompt (Factory) ───────────────────────────────────────────
PS1=$'%{\033[38;2;239;111;46m%}%n%{\033[0m%}:%{\033[38;2;214;211;210m%}%~%{\033[0m%}%{\033[38;2;138;131;128m%}\$%{\033[0m%} '

# ─── ls colors (Factory) ────────────────────────────────────────
# macOS LSCOLORS: 11 pairs (fg+bg) for:
#   directory, symlink, socket, pipe, exec, block-special,
#   char-special, setuid-exec, setgid-exec, sticky-dir, no-sticky-dir
# Limited to the 8 ANSI slots, so dirs use bold yellow, which resolves to the
# Factory orange accent. Symlinks=cyan, sockets=magenta, exec=green. Block and
# char devices keep their blue fg here because their background colors still
# separate them from dirs; the GNU list below moves them to light orange instead.
export CLICOLOR=1
export LSCOLORS="Dxgxfxdxcxegedabagacad"

# GNU LS_COLORS (for coreutils ls, tree, eza, fd, etc.)
export LS_COLORS="di=1;38;2;239;111;46:ln=38;2;34;211;238:so=38;2;192;132;252:pi=38;2;255;184;108:ex=38;2;52;211;153:bd=38;2;255;184;108:cd=38;2;255;184;108:su=38;2;248;113;113:sg=38;2;248;113;113:tw=38;2;239;111;46;48;2;31;29;28:ow=38;2;239;111;46:*.md=38;2;138;131;128:*.json=38;2;255;184;108:*.toml=38;2;255;184;108:*.yaml=38;2;255;184;108:*.yml=38;2;255;184;108:*.ts=38;2;96;165;250:*.tsx=38;2;96;165;250:*.js=38;2;255;184;108:*.py=38;2;52;211;153:*.rs=38;2;248;113;113:*.go=38;2;34;211;238:*.sh=38;2;52;211;153:*.css=38;2;192;132;252:*.html=38;2;248;113;113:*.svg=38;2;248;113;113:*.png=38;2;192;132;252:*.jpg=38;2;192;132;252:*.gif=38;2;192;132;252:*.zip=38;2;248;113;113:*.tar=38;2;248;113;113:*.gz=38;2;248;113;113:*.log=38;2;138;131;128:*.bak=38;2;138;131;128:*.tmp=38;2;138;131;128"

# ─── grep colors (Factory) ──────────────────────────────────────
export GREP_OPTIONS="--color=auto"
export GREP_COLOR="38;2;239;111;46"
export GREP_COLORS="mt=38;2;239;111;46:fn=38;2;138;131;128:ln=38;2;138;131;128:se=38;2;31;29;28"
alias grep="grep --color=auto"

# ─── man pages colors (Factory) ─────────────────────────────────
export LESS_TERMCAP_mb=$'\033[38;2;248;113;113m'
export LESS_TERMCAP_md=$'\033[38;2;239;111;46m'
export LESS_TERMCAP_me=$'\033[0m'
export LESS_TERMCAP_so=$'\033[38;2;2;2;2;48;2;239;111;46m'
export LESS_TERMCAP_se=$'\033[0m'
export LESS_TERMCAP_us=$'\033[38;2;52;211;153m'
export LESS_TERMCAP_ue=$'\033[0m'

# ─── less pager (Factory) ───────────────────────────────────────
export LESS="-R"

# ─── diff colors ───────────────────────────────────────────────────────
alias diff="diff --color=auto"

# ─── zsh completion colors ─────────────────────────────────────────────
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format $'\033[38;2;239;111;46m-- %d --\033[0m'
zstyle ':completion:*:messages' format $'\033[38;2;138;131;128m-- %d --\033[0m'
zstyle ':completion:*:warnings' format $'\033[38;2;248;113;113m-- no matches --\033[0m'

# ─── Aliases ────────────────────────────────────────────────────────────
# Personal aliases live in ~/.aliases.local (private, not tracked in this repo).
[ -f "$HOME/.aliases.local" ] && source "$HOME/.aliases.local"

export PATH="$HOME/.local/bin:$PATH"


# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

autoload -Uz compinit && compinit
