export LESS="-R"

# ─── diff colors ───────────────────────────────────────────────────────
alias diff="diff --color=auto"

# ─── zsh completion colors ─────────────────────────────────────────────
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format $'\033[38;2;239;111;46m-- %d --\033[0m'
zstyle ':completion:*:messages' format $'\033[38;2;138;131;128m-- %d --\033[0m'
zstyle ':completion:*:warnings' format $'\033[38;2;248;113;113m-- no matches --\033[0m'

# ─── Aliases ────────────────────────────────────────────────────────────
alias cf="***REMOVED*** tunnel run"
alias prox1="ssh root@***REMOVED***"
alias prox2="ssh root@***REMOVED***"
alias prox3="ssh root@***REMOVED***"
alias prox4="ssh root@***REMOVED***"

alias ll="ls -lAhG"
alias ..="cd .."
alias ...="cd ../.."

# ─── History ────────────────────────────────────────────────────────────
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

# ─── Path ───────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"
