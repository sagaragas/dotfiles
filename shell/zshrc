# ─── Prompt (Modus Operandi Tinted) ─────────────────────────────────────
PS1=$'%{\033[38;2;166;0;0m%}%n%{\033[0m%}:%{\033[38;2;0;0;0m%}%~%{\033[0m%}%{\033[38;2;89;89;89m%}\$%{\033[0m%} '

# ─── ls colors (Modus Operandi Tinted) ──────────────────────────────────
# macOS LSCOLORS: 11 pairs (fg+bg) for:
#   directory, symlink, socket, pipe, exec, block-special,
#   char-special, setuid-exec, setgid-exec, sticky-dir, no-sticky-dir
# Modus: dirs=red, symlinks=cyan, exec=green, sockets=magenta
export CLICOLOR=1
export LSCOLORS="Dxgxfxdxcxegedabagacad"

# GNU LS_COLORS (for coreutils ls, tree, eza, fd, etc.)
export LS_COLORS="di=1;38;2;166;0;0:ln=38;2;0;94;139:so=38;2;114;16;69:pi=38;2;111;85;0:ex=38;2;0;104;0:bd=38;2;0;49;169:cd=38;2;0;49;169:su=38;2;151;37;0:sg=38;2;151;37;0:tw=38;2;166;0;0;48;2;194;188;181:ow=38;2;166;0;0:*.md=38;2;89;89;89:*.json=38;2;111;85;0:*.toml=38;2;111;85;0:*.yaml=38;2;111;85;0:*.yml=38;2;111;85;0:*.ts=38;2;0;49;169:*.tsx=38;2;0;49;169:*.js=38;2;111;85;0:*.py=38;2;0;104;0:*.rs=38;2;166;0;0:*.go=38;2;0;94;139:*.sh=38;2;0;104;0:*.css=38;2;114;16;69:*.html=38;2;166;0;0:*.svg=38;2;166;0;0:*.png=38;2;114;16;69:*.jpg=38;2;114;16;69:*.gif=38;2;114;16;69:*.zip=38;2;166;0;0:*.tar=38;2;166;0;0:*.gz=38;2;166;0;0:*.log=38;2;89;89;89:*.bak=38;2;89;89;89:*.tmp=38;2;89;89;89"

# ─── grep colors (Modus Operandi Tinted) ────────────────────────────────
export GREP_OPTIONS="--color=auto"
export GREP_COLOR="38;2;166;0;0"
export GREP_COLORS="mt=38;2;166;0;0:fn=38;2;89;89;89:ln=38;2;89;89;89:se=38;2;166;166;166"
alias grep="grep --color=auto"

# ─── man pages colors (Modus Operandi Tinted) ───────────────────────────
export LESS_TERMCAP_mb=$'\033[38;2;151;37;0m'
export LESS_TERMCAP_md=$'\033[38;2;166;0;0m'
export LESS_TERMCAP_me=$'\033[0m'
export LESS_TERMCAP_so=$'\033[38;2;251;247;240;48;2;166;0;0m'
export LESS_TERMCAP_se=$'\033[0m'
export LESS_TERMCAP_us=$'\033[38;2;0;104;0m'
export LESS_TERMCAP_ue=$'\033[0m'

# ─── less pager (Modus Operandi Tinted) ─────────────────────────────────
export LESS="-R"

# ─── diff colors ───────────────────────────────────────────────────────
alias diff="diff --color=auto"

# ─── zsh completion colors ─────────────────────────────────────────────
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format $'\033[38;2;166;0;0m-- %d --\033[0m'
zstyle ':completion:*:messages' format $'\033[38;2;89;89;89m-- %d --\033[0m'
zstyle ':completion:*:warnings' format $'\033[38;2;151;37;0m-- no matches --\033[0m'

# ─── Aliases ────────────────────────────────────────────────────────────
# Personal aliases live in ~/.aliases.local (private, not tracked in this repo).
[ -f "$HOME/.aliases.local" ] && source "$HOME/.aliases.local"

export PATH="$HOME/.local/bin:$PATH"


# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

autoload -Uz compinit && compinit
